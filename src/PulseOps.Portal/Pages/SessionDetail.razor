@page "/sessions/{Id}"
@inherits ScopedPage

<PageTitle>Session timeline · PulseOps</PageTitle>
<a class="back-link" href="@Scope.Url("sessions")">Session explorer</a>
<PageHeader Title="Session timeline" Description="@Id" Section="Session" />

@if (Error is not null || UpdatedAt is null)
{
    <DataState Loading="Loading" Error="@Error" SignIn="SignInRequired" Retry="RefreshAsync" />
}
else if (_session is null)
{
    <DataState IconName="sessions" EmptyTitle="Session unavailable" EmptyText="The session has no events in your selected scope and time range." />
}
else
{
    <section class="panel">
        <div class="panel-head">
            <div><h2>@AppLabel(_session.Application)</h2><p>@Presentation.Title(_session.Environment) · @_session.Version</p></div>
            <Badge Text="@_session.Health" Dot="true" />
        </div>
        <dl class="detail-facts">
            <div><dt>First observed</dt><dd>@Presentation.Date(_session.FirstSeen)</dd></div>
            <div><dt>Last observed</dt><dd>@Presentation.Date(_session.LastSeen)</dd></div>
            <div><dt>Events</dt><dd>@Presentation.Count(_session.EventCount)</dd></div>
            <div><dt>Failures</dt><dd>@Presentation.Count(_session.Failures)</dd></div>
        </dl>
    </section>
    <section class="panel">
        <div class="panel-head">
            <div><h2>Observed events</h2><p>Newest activity first. Times shown in UTC.</p></div>
            <label class="select-mini">
                <span class="sr-only">Event type</span>
                <select value="@Kind" @onchange="ChangeKind">
                    <option value="">All event types</option>
                    @foreach (var kind in EventKinds.All)
                    {
                        <option value="@kind.Value">@kind.Label</option>
                    }
                </select>
            </label>
        </div>
        @if (_events.Length == 0)
        {
            <DataState IconName="clock" EmptyTitle="No matching events" />
        }
        else
        {
            <ol class="timeline">
                @foreach (var trace in _events)
                {
                    <li>
                        <span class="timeline-marker @Presentation.Tone(trace.Outcome)"></span>
                        <time class="timeline-time" datetime="@trace.OccurredAt.ToString("O")">@Presentation.Date(trace.OccurredAt)</time>
                        <div class="timeline-content">
                            <div class="timeline-title">
                                <Badge Text="@EventKinds.LabelFor(trace.Kind)" Tone="neutral" />
                                <strong>@trace.Name</strong>
                                @if (trace.Outcome is { Length: > 0 }) { <Badge Text="@trace.Outcome" /> }
                            </div>
                            <div class="event-meta">
                                @if (trace.StatusCode is int status) { <span>HTTP @status</span> }
                                @if (trace.DurationMs.HasValue) { <span>@Presentation.Duration(trace.DurationMs)</span> }
                                @if (trace.Category is { Length: > 0 }) { <span>@trace.Category</span> }
                                @if (trace.TraceId is { Length: > 0 })
                                {
                                    <a href="@Scope.For(trace.Application, trace.Environment).Url("traces", ("traceId", trace.TraceId))">Inspect trace</a>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ol>
        }
        <Pager Count="_events.Length" Offset="Skip" Link="PageLink" />
    </section>
}

@code {
    [Parameter] public string Id { get; set; } = "";
    [SupplyParameterFromQuery] public string? Kind { get; set; }

    private BrowserSession? _session;
    private TelemetryEvent[] _events = [];

    protected override async Task LoadAsync(CancellationToken cancellationToken)
    {
        var result = await Api.GetAsync<BrowserSession[]>(Scope.Url("sessions", ("sessionId", Id), ("limit", "1")), cancellationToken);
        var session = result.FirstOrDefault();
        TelemetryEvent[] events = session is null ? [] : await Api.GetAsync<TelemetryEvent[]>(
            Scope.For(session.Application, session.Environment).Url("events", ("sessionId", Id), ("kind", Kind),
                ("limit", "50"), ("offset", Skip.ToString(CultureInfo.InvariantCulture))), cancellationToken);
        cancellationToken.ThrowIfCancellationRequested();
        _session = session;
        _events = events;
    }

    private string PageLink(int offset) => Scope.Url("sessions/" + Uri.EscapeDataString(Id), ("kind", Kind),
        ("offset", offset.ToString(CultureInfo.InvariantCulture)));

    private void ChangeKind(ChangeEventArgs args)
    {
        Navigation.NavigateTo(Scope.Url("sessions/" + Uri.EscapeDataString(Id), ("kind", args.Value?.ToString())));
    }
}
